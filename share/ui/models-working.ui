<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  
  <!-- Data Models -->
  <object class="GtkListStore" id="ModelList">
    <columns>
      <column type="gchararray"/>
    </columns>
  </object>
  
  <!-- Main Models Tab Content -->
  <object class="GtkPaned" id="ModelBox">
    <property name="orientation">horizontal</property>
    <property name="position">300</property>
    
    <!-- Left: Model List and Controls -->
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">5</property>
        <property name="margin-start">5</property>
        <property name="margin-end">5</property>
        <property name="margin-top">5</property>
        <property name="margin-bottom">5</property>
        
        <!-- Model List -->
        <child>
          <object class="GtkScrolledWindow">
            <property name="vexpand">true</property>
            <property name="hscrollbar-policy">never</property>
            <child>
              <object class="GtkTreeView" id="ModelView">
                <property name="model">ModelList</property>
                <property name="headers-visible">false</property>
                <child>
                  <object class="GtkTreeViewColumn" id="VisibleColumn">
                    <property name="title">Visible</property>
                    <child>
                      <object class="GtkCellRendererPixbuf" id="VisibleSymbol">
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkTreeViewColumn" id="NameColumn">
                    <property name="title">Name</property>
                    <child>
                      <object class="GtkCellRendererText" id="NameCell">
                        <property name="editable">true</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <!-- Model Controls -->
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="homogeneous">true</property>
            <property name="spacing">5</property>
            <child>
              <object class="GtkColorButton" id="ModelColorButton">
                <property name="use-alpha">true</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="ModelDelete">
                <property name="label">Delete</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="ModelDeleteAll">
                <property name="label">Clear</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="ModelMoveUp">
                <property name="label">↑</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="ModelMoveDown">
                <property name="label">↓</property>
              </object>
            </child>
          </object>
        </child>

        <!-- Help Link -->
        <child>
          <object class="GtkLinkButton" id="ModelTransformationsHelp">
            <property name="label">Help</property>
            <property name="uri">http://pycam.sourceforge.net/</property>
          </object>
        </child>
      </object>
    </child>

    <!-- Right: Model Transformations -->
    <child>
      <object class="GtkNotebook" id="ModelHandlingNotebook">
        <property name="tab-pos">left</property>
        <property name="width-request">200</property>
        <!-- Pages will be added dynamically -->
    <property name="show-tabs">true</property>
    <property name="scrollable">true</property>
    <property name="enable-popup">true</property>

        <child>
          <object class="GtkNotebookPage">
            <property name="child">
              <object class="GtkLabel">
                <property name="label">Model transformations will be loaded here</property>
              </object>
            </property>
            <property name="tab">
              <object class="GtkLabel">
                <property name="label">Info</property>
              
                    <property name="width-request">50</property></object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>