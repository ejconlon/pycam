<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkApplicationWindow" id="ProjectWindow">
    <property name="title">PyCAM</property>
    <property name="default-width">800</property>
    <property name="default-height">600</property>
    <child>
      <object class="GtkBox" id="WindowBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkPopoverMenuBar" id="MenuBar">
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label">PyCAM - GTK 4</property>
            <property name="margin-top">20</property>
            <property name="margin-bottom">20</property>
          </object>
        </child>
        <child>
          <object class="GtkNotebook" id="MainTabs">
            <property name="vexpand">true</property>
            <property name="width-request">200</property>
    <property name="show-tabs">true</property>
    <property name="scrollable">true</property>
    <property name="enable-popup">true</property>

            <child>
              <object class="GtkNotebookPage">
                <property name="child">
                  <object class="GtkLabel">
                    <property name="label">Models Tab Content</property>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel">
                    <property name="label">Models</property>
                  
                    <property name="width-request">50</property></object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkNotebookPage">
                <property name="child">
                  <object class="GtkLabel">
                    <property name="label">Tools Tab Content</property>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel">
                    <property name="label">Tools</property>
                  
                    <property name="width-request">50</property></object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkDialog" id="AboutWindow">
    <property name="title">About PyCAM</property>
    <property name="modal">true</property>
    <child internal-child="content_area">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin-top">20</property>
        <property name="margin-bottom">20</property>
        <property name="margin-start">20</property>
        <property name="margin-end">20</property>
        <child>
          <object class="GtkLabel">
            <property name="label">PyCAM</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label">Toolpath Generation for 3-Axis CNC machining</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkDialog" id="GeneralSettingsWindow">
    <property name="title">PyCAM Preferences</property>
    <property name="modal">true</property>
    <child internal-child="content_area">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin-top">20</property>
        <property name="margin-bottom">20</property>
        <property name="margin-start">20</property>
        <property name="margin-end">20</property>
        <child>
          <object class="GtkLabel">
            <property name="label">Settings placeholder</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>