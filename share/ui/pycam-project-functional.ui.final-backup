<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  
  <!-- Main Application Window -->
  <object class="GtkApplicationWindow" id="ProjectWindow">
    <property name="title">PyCAM</property>
    <property name="default-width">1200</property>
    <property name="default-height">800</property>
    <child>
      <object class="GtkBox" id="WindowBox">
        <property name="orientation">vertical</property>
        <child>
          <!-- Menu Bar -->
          <object class="GtkPopoverMenuBar" id="MenuBar">
          </object>
        </child>
        <child>
          <!-- Main Content Area -->
          <object class="GtkPaned" id="MainPaned">
            <property name="orientation">horizontal</property>
            <property name="vexpand">true</property>
            <property name="position">800</property>
            
            <!-- Left Side: Main Tabs -->
            <child>
              <object class="GtkNotebook" id="MainTabs">
                <property name="vexpand">true</property>
                <property name="hexpand">true</property>
                <!-- Tabs will be added dynamically by plugins -->
              </object>
            </child>
            
            <!-- Right Side: 3D View -->
            <child>
              <object class="GtkBox" id="ViewArea">
                <property name="orientation">vertical</property>
                <property name="vexpand">true</property>
                <property name="width-request">400</property>
                <child>
                  <object class="GtkLabel" id="ViewPlaceholder">
                    <property name="label">3D View Area</property>
                    <property name="vexpand">true</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        
        <!-- Toolbar -->
        <child>
          <object class="GtkBox" id="ToolbarArea">
            <property name="orientation">horizontal</property>
            <property name="margin-start">5</property>
            <property name="margin-end">5</property>
            <property name="margin-top">2</property>
            <property name="margin-bottom">2</property>
            <property name="spacing">5</property>
            <child>
              <object class="GtkButton" id="UndoButton">
                <property name="label">Undo</property>
                <property name="tooltip-text">Undo the last action</property>
                <property name="sensitive">false</property>
              </object>
            </child>
            <child>
              <object class="GtkSeparator">
                <property name="orientation">vertical</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="hexpand">true</property>
              </object>
            </child>
          </object>
        </child>
        
        <!-- Status Bar -->
        <child>
          <object class="GtkStatusbar" id="StatusBar">
            <property name="margin-start">5</property>
            <property name="margin-end">5</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  
  <!-- About Dialog -->
  <object class="GtkAboutDialog" id="AboutWindow">
    <property name="title">About PyCAM</property>
    <property name="transient-for">ProjectWindow</property>
    <property name="program-name">PyCAM</property>
    <property name="version">0.7.x-GTK4</property>
    <property name="copyright">Copyright © 2008-2010 Lode Leroy
Copyright © 2010-2011 Lars Kruse</property>
    <property name="comments">Toolpath Generation for 3-Axis CNC machining</property>
    <property name="website">http://pycam.sourceforge.net/</property>
    <property name="website-label">Website of the PyCAM project</property>
    <property name="license-type">gpl-3-0</property>
    <property name="wrap-license">true</property>
  </object>
  
  <!-- Placeholder Progress Dialog -->
  <object class="GtkDialog" id="ProgressDialog">
    <property name="title">Processing...</property>
    <property name="transient-for">ProjectWindow</property>
    <property name="modal">true</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin-top">10</property>
        <property name="margin-bottom">10</property>
        <property name="margin-start">10</property>
        <property name="margin-end">10</property>
        <child>
          <object class="GtkProgressBar" id="ProgressBar">
            <property name="show-text">true</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="ProgressLabel">
            <property name="label">Processing...</property>
          </object>
        </child>
      </object>
    </child>
  </object>

  <!-- Preferences Dialog -->
  <object class="GtkDialog" id="GeneralSettingsWindow">
    <property name="title">PyCAM Preferences</property>
    <property name="modal">true</property>
    <property name="transient-for">ProjectWindow</property>
    <property name="default-width">600</property>
    <property name="default-height">400</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin-start">20</property>
        <property name="margin-end">20</property>
        <property name="margin-top">20</property>
        <property name="margin-bottom">20</property>
        
        <!-- Logo -->
        <child>
          <object class="GtkImage" id="logo">
            <property name="icon-name">preferences-desktop</property>
            <property name="margin-bottom">10</property>
            <property name="icon-size">large</property>
          </object>
        </child>
        
        <!-- Preferences Notebook -->
        <child>
          <object class="GtkNotebook" id="PreferencesNotebook">
            <property name="vexpand">true</property>
            <!-- Pages will be added dynamically by plugins -->
            <child>
              <object class="GtkNotebookPage">
                <property name="child">
                  <object class="GtkLabel">
                    <property name="label">Preferences will be loaded here</property>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel">
                    <property name="label">General</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    
    <!-- Dialog Buttons -->
    <child type="action">
      <object class="GtkButton" id="ResetPreferencesButton">
        <property name="label">Reset to Defaults</property>
      </object>
    </child>
    <child type="action">
      <object class="GtkButton" id="CloseSettingsWindow">
        <property name="label">Close</property>
      </object>
    </child>
    <action-widgets>
      <action-widget response="1">ResetPreferencesButton</action-widget>
      <action-widget response="0">CloseSettingsWindow</action-widget>
    </action-widgets>
  </object>

  <!-- Preferences Tab Objects -->
  
  <!-- General Settings Tab -->
  <object class="GtkFrame" id="GeneralSettingsPrefTab">
    <property name="margin-start">10</property>
    <property name="margin-end">10</property>
    <property name="margin-top">10</property>
    <property name="margin-bottom">10</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin-start">15</property>
        <property name="margin-end">15</property>
        <property name="margin-top">15</property>
        <property name="margin-bottom">15</property>
        
        <child>
          <object class="GtkLabel">
            <property name="label">General PyCAM application settings</property>
            <property name="wrap">true</property>
            <property name="justify">center</property>
            <property name="margin-bottom">15</property>
          </object>
        </child>
        
        <!-- General Settings Options -->
        <child>
          <object class="GtkCheckButton" id="GeneralAutoLoadLastModel">
            <property name="label">Automatically load last opened model on startup</property>
            <property name="tooltip-text">Reload the previously opened model when PyCAM starts</property>
          </object>
        </child>
        
        <child>
          <object class="GtkCheckButton" id="GeneralShowTooltips">
            <property name="label">Show tooltips and help text</property>
            <property name="active">true</property>
            <property name="tooltip-text">Display helpful tooltips throughout the interface</property>
          </object>
        </child>
        
        <child>
          <object class="GtkCheckButton" id="GeneralConfirmOperations">
            <property name="label">Confirm potentially destructive operations</property>
            <property name="active">true</property>
            <property name="tooltip-text">Ask for confirmation before operations that might lose work</property>
          </object>
        </child>
      </object>
    </child>
  </object>

  <!-- Programs Settings Tab -->
  <object class="GtkFrame" id="ProgramsPrefTab">
    <property name="margin-start">10</property>
    <property name="margin-end">10</property>
    <property name="margin-top">10</property>
    <property name="margin-bottom">10</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin-start">15</property>
        <property name="margin-end">15</property>
        <property name="margin-top">15</property>
        <property name="margin-bottom">15</property>
        
        <child>
          <object class="GtkLabel">
            <property name="label">Configure external programs for 2D vector import</property>
            <property name="wrap">true</property>
            <property name="justify">center</property>
            <property name="margin-bottom">15</property>
          </object>
        </child>
        
        <!-- Inkscape Configuration -->
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">10</property>
            <property name="margin-bottom">10</property>
            <child>
              <object class="GtkLabel">
                <property name="label">Inkscape:</property>
                <property name="width-chars">12</property>
                <property name="xalign">0</property>
              </object>
            </child>
            <child>
              <object class="GtkEntry" id="ExternalProgramInkscapeControl">
                <property name="hexpand">true</property>
                <property name="placeholder-text">Path to inkscape executable...</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="ExternalProgramInkscapeAuto">
                <property name="label">Detect</property>
                <property name="tooltip-text">Automatically detect Inkscape installation</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="ExternalProgramInkscapeBrowse">
                <property name="label">Browse</property>
                <property name="tooltip-text">Browse for Inkscape executable</property>
              </object>
            </child>
          </object>
        </child>
        
        <!-- pstoedit Configuration -->
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">10</property>
            <property name="margin-bottom">10</property>
            <child>
              <object class="GtkLabel">
                <property name="label">pstoedit:</property>
                <property name="width-chars">12</property>
                <property name="xalign">0</property>
              </object>
            </child>
            <child>
              <object class="GtkEntry" id="ExternalProgramPstoeditControl">
                <property name="hexpand">true</property>
                <property name="placeholder-text">Path to pstoedit executable...</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="ExternalProgramPstoeditAuto">
                <property name="label">Detect</property>
                <property name="tooltip-text">Automatically detect pstoedit installation</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="ExternalProgramPstoeditBrowse">
                <property name="label">Browse</property>
                <property name="tooltip-text">Browse for pstoedit executable</property>
              </object>
            </child>
          </object>
        </child>
        
        <!-- Help Links -->
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">10</property>
            <property name="margin-top">15</property>
            <child>
              <object class="GtkLinkButton" id="ExternalProgramPstoeditLink">
                <property name="label">pstoedit website</property>
                <property name="tooltip-text">pstoedit is a postscript conversion tool for converting 2D SVG files into DXF contour models</property>
                <property name="uri">http://www.pstoedit.net/pstoedit</property>
              </object>
            </child>
            <child>
              <object class="GtkSeparator">
                <property name="orientation">vertical</property>
              </object>
            </child>
            <child>
              <object class="GtkLinkButton" id="ExternalProgramsHelp">
                <property name="label">External Programs Help</property>
                <property name="tooltip-text">PyCAM external programs documentation</property>
                <property name="uri">http://pycam.sourceforge.net/requirements/#optional-external-programs</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>

</interface>