<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  
  <!-- Data Models -->
  <object class="GtkListStore" id="ProcessList">
    <columns>
      <column type="gchararray"/>
    </columns>
  </object>
  
  <object class="GtkListStore" id="StrategyModel">
    <columns>
      <column type="gchararray"/>
      <column type="gchararray"/>
    </columns>
    <data>
      <row>
        <col id="0">Slicing</col>
        <col id="1">slicing</col>
      </row>
      <row>
        <col id="0">Surfacing</col>
        <col id="1">surfacing</col>
      </row>
    </data>
  </object>
  
  <!-- Main Processes Tab Content -->
  <object class="GtkPaned" id="ProcessBox">
    <property name="orientation">horizontal</property>
    <property name="position">300</property>
    
    <!-- Left: Process List and Controls -->
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">5</property>
        <property name="margin-start">5</property>
        <property name="margin-end">5</property>
        <property name="margin-top">5</property>
        <property name="margin-bottom">5</property>
        
        <!-- Process List -->
        <child>
          <object class="GtkScrolledWindow">
            <property name="vexpand">true</property>
            <property name="hscrollbar-policy">never</property>
            <child>
              <object class="GtkTreeView" id="ProcessEditorTable">
                <property name="model">ProcessList</property>
                <property name="headers-visible">false</property>
                <child>
                  <object class="GtkTreeViewColumn" id="NameColumn">
                    <property name="title">Name</property>
                    <child>
                      <object class="GtkCellRendererText" id="NameCell">
                        <property name="editable">true</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="DescriptionColumn">
                    <property name="title">Description</property>
                    <child>
                      <object class="GtkCellRendererText" id="DescriptionCell">
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        
        <!-- Process Controls -->
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="homogeneous">true</property>
            <property name="spacing">5</property>
            <child>
              <object class="GtkButton" id="ProcessNew">
                <property name="label">New</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="ProcessDelete">
                <property name="label">Delete</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="ProcessMoveUp">
                <property name="label">↑</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="ProcessMoveDown">
                <property name="label">↓</property>
              </object>
            </child>
          </object>
        </child>
        
        <!-- Strategy Selector -->
        <child>
          <object class="GtkBox" id="ProcessSelectorBox">
            <property name="orientation">vertical</property>
            <property name="spacing">5</property>
            <child>
              <object class="GtkLabel">
                <property name="label">Strategy:</property>
                <property name="xalign">0</property>
              </object>
            </child>
            <child>
              <object class="GtkComboBox" id="StrategySelector">
                <property name="model">StrategyModel</property>
                <child>
                  <object class="GtkCellRendererText" id="StrategyLabelCell"/>
                  <attributes>
                    <attribute name="text">0</attribute>
                  </attributes>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    
    <!-- Right: Process Parameters -->
    <child>
      <object class="GtkBox" id="ProcessSettingsControlsBox">
        <property name="orientation">vertical</property>
        <property name="spacing">5</property>
        <property name="margin-start">5</property>
        <property name="margin-end">5</property>
        <property name="margin-top">5</property>
        <property name="margin-bottom">5</property>
        
        <child>
          <object class="GtkScrolledWindow">
            <property name="vexpand">true</property>
            <child>
              <object class="GtkBox" id="ProcessParametersBox">
                <property name="orientation">vertical</property>
                <property name="spacing">5</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Process parameters will be loaded here</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>